# Never commit real API keys.
GEMINI_API_KEY=
GROQ_API_KEY=

# Provider/model overrides
MODEL_ID=gemini-3.6-flash
GROQ_MODEL_ID=llama-3.3-70b-versatile

# Generation / experiment controls
INCLUDE_DOCTESTS=false
TEMPERATURE=1.0
MAX_OUTPUT_TOKENS=8192
PANEL_SIZE=3
MAX_RETRIES=3
MAX_RETRY_DELAY_SECONDS=90

# List-price equivalents used only for estimated-cost logging.
# Re-check provider pricing before using cost numbers in the paper.
PRICE_IN=0.50
PRICE_OUT=3.00
GROQ_PRICE_IN=0.59
GROQ_PRICE_OUT=0.79
